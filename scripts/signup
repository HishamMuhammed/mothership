#!/usr/bin/env bash
# signup — write user-vms/<name>.nix for a PR. does NOT provision by itself.
# git is the IdP. this script is a typewriter, not a control plane.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

usage() {
  cat <<'EOF'
usage: scripts/signup --name <user> --key <ssh-ed25519-A…> [--tier small|medium|large] [--github <handle>]

writes user-vms/<name>.nix then tells you to open a PR.
nothing is created on the host until that PR merges and the box rebuilds.
EOF
  exit 1
}

name=""
key=""
tier="small"
github=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) name="${2:-}"; shift 2 ;;
    --key) key="${2:-}"; shift 2 ;;
    --tier) tier="${2:-}"; shift 2 ;;
    --github) github="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "unknown arg: $1" >&2; usage ;;
  esac
done

[[ -n "$name" && -n "$key" ]] || usage

if [[ ! "$name" =~ ^[a-z][a-z0-9-]{1,15}$ ]]; then
  echo "reject: bad name '$name' (want ^[a-z][a-z0-9-]{1,15}$)" >&2
  exit 1
fi
case "$tier" in small|medium|large) ;; *)
  echo "reject: bad tier $tier" >&2; exit 1 ;;
esac

# reserved house / system names (keep in sync with lib/memberPolicy.nix)
reserved_re='^(root|admin|administrator|ubuntu|nixos|git|www|api|mail|ftp|ssh|host|gateway|router|edge|mothership|headscale|bastion|proxy|nginx|deck|template|localhost)$'
if [[ "$name" =~ $reserved_re ]]; then
  echo "reject: name '$name' is reserved. pick another." >&2
  exit 1
fi

out="user-vms/${name}.nix"
# one name = one seat. second requester loses.
if [[ -e "$out" ]]; then
  echo "reject: name taken — $out already exists. pick another name." >&2
  exit 1
fi
lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# belt: any existing member file with same name (case fold; regex already lower)
shopt -s nullglob
name_lc="$(lc "$name")"
for f in user-vms/*.nix; do
  base="$(basename "$f" .nix)"
  [[ "$base" == "template" ]] && continue
  if [[ "$(lc "$base")" == "$name_lc" ]]; then
    echo "reject: name taken — member '${base}' already exists. pick another." >&2
    exit 1
  fi
done

# same github handle cannot own two seats
if [[ -n "$github" ]]; then
  gh_lc="$(lc "$github")"
  for f in user-vms/*.nix; do
    base="$(basename "$f" .nix)"
    [[ "$base" == "template" ]] && continue
    existing="$(grep -E '^[[:space:]]*github[[:space:]]*=' "$f" 2>/dev/null | head -1 | sed -E 's/.*"([^"]+)".*/\1/' || true)"
    [[ -z "$existing" ]] && continue
    if [[ "$(lc "$existing")" == "$gh_lc" ]]; then
      echo "reject: github '@${github}' already used by member '${base}'. one handle, one seat." >&2
      exit 1
    fi
  done
fi

{
  echo "# member: ${name} — provisioned only after merge to main"
  echo "{"
  if [[ -n "$github" ]]; then
    echo "  github = \"${github}\";"
  fi
  echo "  tier = \"${tier}\";"
  echo "  enabled = true;"
  echo "  keys = ["
  echo "    \"${key}\""
  echo "  ];"
  echo "}"
} >"$out"

cat <<EOF
wrote ${out}

next:
  git checkout -b member/${name}
  git add ${out}
  git commit -m "member: add ${name} (${tier})"
  git push -u origin HEAD
  # open PR → review → merge → mothership rebuild → microvm@${name}

mesh (after the guest is up + joined headscale):
  ssh ${name}@${name}
  # or: ssh ${name}@${name}.mesh.tinkerhub
  # unique IP: whatever headscale assigned (tailscale ip -4 inside the guest)

this script does not call the server. on purpose.
EOF
