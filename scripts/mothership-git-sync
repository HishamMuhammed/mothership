#!/usr/bin/env bash
# mothership-git-sync — path-aware pull + activate
#
# git is the IdP. this is the wire from main → metal.
#
# paths:
#   only user-vms/*          → member mode: nixos-rebuild switch
#                              (must switch host: bastion + publish + microvm units
#                              are generated from the host config. unchanged
#                              microvm@* units should NOT restart.)
#   hosts/mothership|modules|lib|flake.* → fabric mode: full switch
#   only edge/sites/docs/... → update checkout, skip rebuild
#
# env (optional):
#   MOTHERSHIP_SRC     checkout path     default /var/lib/mothership/src
#   MOTHERSHIP_REMOTE  git remote URL    default https://github.com/tinkerhub0/mothership.git
#   MOTHERSHIP_BRANCH  branch            default main
#   MOTHERSHIP_FLAKE   flake attr        default mothership
#   MOTHERSHIP_DRY_RUN=1                 log only, no pull/switch
set -euo pipefail

SRC="${MOTHERSHIP_SRC:-/var/lib/mothership/src}"
REMOTE="${MOTHERSHIP_REMOTE:-https://github.com/tinkerhub0/mothership.git}"
BRANCH="${MOTHERSHIP_BRANCH:-main}"
FLAKE_HOST="${MOTHERSHIP_FLAKE:-mothership}"
STATE_DIR="${MOTHERSHIP_STATE:-/var/lib/mothership/git-sync}"
LOCK="${STATE_DIR}/sync.lock"
DRY="${MOTHERSHIP_DRY_RUN:-0}"

log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"; }
die() { log "error: $*"; exit 1; }

mkdir -p "$STATE_DIR"

# single flight — timer can fire while a rebuild is still running
if command -v flock >/dev/null 2>&1; then
  exec 9>"$LOCK"
  if ! flock -n 9; then
    log "another sync holds the lock; exit"
    exit 0
  fi
else
  log "warn: flock missing; concurrent runs possible"
fi

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing $1"; }
need_cmd git
need_cmd nix
need_cmd nixos-rebuild
need_cmd systemctl

# --- checkout ---------------------------------------------------------------
if [[ ! -d "$SRC/.git" ]]; then
  log "clone $REMOTE → $SRC"
  if [[ "$DRY" == "1" ]]; then
    log "dry-run: would clone"
    exit 0
  fi
  mkdir -p "$(dirname "$SRC")"
  git clone --depth 50 --branch "$BRANCH" "$REMOTE" "$SRC"
fi

cd "$SRC"
git remote set-url origin "$REMOTE" 2>/dev/null || git remote add origin "$REMOTE"

OLD="$(git rev-parse HEAD)"
log "fetch origin/$BRANCH (at $OLD)"
if [[ "$DRY" != "1" ]]; then
  # prune + full tip; depth-only fetch breaks after force-push rewrites
  git fetch --prune origin "+refs/heads/${BRANCH}:refs/remotes/origin/${BRANCH}"
fi

NEW="$(git rev-parse "origin/$BRANCH" 2>/dev/null || true)"
if [[ -z "$NEW" ]]; then
  die "origin/$BRANCH missing after fetch"
fi

if [[ "$OLD" == "$NEW" ]]; then
  log "no changes ($OLD)"
  exit 0
fi

# content diff even when histories diverged (force-push / squash)
mapfile -t CHANGED < <(git diff --name-only "$OLD" "$NEW" 2>/dev/null || true)
if [[ ${#CHANGED[@]} -eq 0 ]]; then
  log "empty name-diff $OLD..$NEW; treating as fabric rebuild to be safe"
  # force a rebuild path rather than silent skip on weird history
  CHANGED=("flake.nix")
fi

log "changes $OLD → $NEW:"
printf '  %s\n' "${CHANGED[@]:-}"

# --- classify ---------------------------------------------------------------
member_hits=()
fabric=0
relevant=0

is_member_path() {
  case "$1" in
    user-vms/*.nix) return 0 ;;
    user-vms/*) return 0 ;;
    *) return 1 ;;
  esac
}

is_fabric_path() {
  case "$1" in
    hosts/mothership/*|modules/*|lib/*|flake.nix|flake.lock) return 0 ;;
    # sync script is packaged into the host generation
    scripts/mothership-git-sync) return 0 ;;
    *) return 1 ;;
  esac
}

is_irrelevant_path() {
  case "$1" in
    hosts/edge/*|sites/*|scripts/*|README*|why-this-exist|*.md|.github/*|AGENTS.md) return 0 ;;
    *) return 1 ;;
  esac
}

# deploy checkout: always hard-reset to origin (no local commits on metal)
checkout_origin() {
  log "reset --hard origin/$BRANCH ($NEW)"
  git checkout -B "$BRANCH" "origin/$BRANCH"
  git reset --hard "$NEW"
  git clean -fd
}

for f in "${CHANGED[@]:-}"; do
  if is_member_path "$f"; then
    relevant=1
    base="$(basename "$f" .nix)"
    if [[ "$f" == user-vms/*.nix && "$base" != "template" ]]; then
      member_hits+=("$base")
    fi
  elif is_fabric_path "$f"; then
    relevant=1
    fabric=1
  elif is_irrelevant_path "$f"; then
    :
  else
    # unknown path: if it could affect the box, rebuild
    log "warn: unclassified path '$f' → fabric rebuild"
    relevant=1
    fabric=1
  fi
done

# unique member names
if [[ ${#member_hits[@]} -gt 0 ]]; then
  mapfile -t member_hits < <(printf '%s\n' "${member_hits[@]}" | sort -u)
fi

mode="skip"
if [[ "$relevant" -eq 1 && "$fabric" -eq 1 ]]; then
  mode="fabric"
elif [[ "$relevant" -eq 1 ]]; then
  mode="member"
fi

log "mode=$mode members=${member_hits[*]:-none}"

# snapshot live microvms before activate (detect unwanted restarts)
snapshot_vms() {
  local out="$1"
  : >"$out"
  systemctl list-units --type=service --state=running --no-legend 'microvm@*' 2>/dev/null \
    | awk '{print $1}' \
    | while read -r u; do
        [[ -z "$u" ]] && continue
        ts="$(systemctl show -p ActiveEnterTimestamp --value "$u" 2>/dev/null || true)"
        printf '%s\t%s\n' "$u" "$ts" >>"$out"
      done || true
}

assert_peers_stable() {
  local before="$1" after="$2"
  local bad=0
  while IFS=$'\t' read -r unit ts; do
    [[ -z "$unit" ]] && continue
    # new unit (not in before) is fine
    old_ts="$(awk -F'\t' -v u="$unit" '$1==u{print $2; exit}' "$before" 2>/dev/null || true)"
    [[ -z "$old_ts" ]] && continue
    new_ts="$(awk -F'\t' -v u="$unit" '$1==u{print $2; exit}' "$after" 2>/dev/null || true)"
    if [[ -n "$new_ts" && "$old_ts" != "$new_ts" ]]; then
      log "WARN peer restarted: $unit ($old_ts → $new_ts)"
      bad=1
    fi
  done <"$after"
  return "$bad"
}

if [[ "$mode" == "skip" ]]; then
  log "checkout only (no mothership rebuild)"
  if [[ "$DRY" == "1" ]]; then
    log "dry-run: would reset --hard to $NEW"
    exit 0
  fi
  checkout_origin
  echo "$NEW" >"${STATE_DIR}/last-skip"
  exit 0
fi

BEFORE="${STATE_DIR}/vms-before.txt"
AFTER="${STATE_DIR}/vms-after.txt"
snapshot_vms "$BEFORE"
log "running microvms before activate:"
cat "$BEFORE" || true

if [[ "$DRY" == "1" ]]; then
  log "dry-run: would reset --hard + nixos-rebuild switch --flake ${SRC}#${FLAKE_HOST} (mode=$mode)"
  exit 0
fi

checkout_origin

log "nixos-rebuild switch --flake ${SRC}#${FLAKE_HOST} (mode=$mode)"
# build+activate on the metal; binary cache keeps this mostly downloads
if ! nixos-rebuild switch --flake "${SRC}#${FLAKE_HOST}"; then
  die "nixos-rebuild switch failed (HEAD left at $NEW — fix and re-run)"
fi

# member mode: poke new/changed guests (autostart usually does this)
if [[ "$mode" == "member" && ${#member_hits[@]} -gt 0 ]]; then
  for name in "${member_hits[@]}"; do
    if [[ -e "/etc/systemd/system/microvm@${name}.service" ]] \
      || systemctl cat "microvm@${name}.service" >/dev/null 2>&1; then
      log "ensure microvm@${name} running"
      systemctl start "microvm@${name}.service" || log "warn: start microvm@${name} failed"
      # host fabric for this guest (tap → bridge) if present
      systemctl start "microvm-br-${name}.service" 2>/dev/null || true
    else
      log "warn: no unit microvm@${name} after switch"
    fi
  done
fi

snapshot_vms "$AFTER"
log "running microvms after activate:"
cat "$AFTER" || true

if ! assert_peers_stable "$BEFORE" "$AFTER"; then
  log "WARN: some peer microvms restarted — check what changed in the generation"
  # do not fail the job: better a loud log than a flapping timer
fi

echo "$NEW" >"${STATE_DIR}/last-success"
echo "$mode" >"${STATE_DIR}/last-mode"
log "done mode=$mode at $NEW"
